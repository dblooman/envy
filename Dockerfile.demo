FROM golang:1.27.1@sha256:512690a5660563b57d37ecc31129e7f136e831db2aed24a1dbeb8ad7380dc0fa AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY demo ./demo
ARG SERVICE
ARG VERSION=v1
# Reuse compilation work across demo variants and local rebuilds.
RUN --mount=type=cache,target=/root/.cache/go-build CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X github.com/dblooman/envy/demo/internal/server.Version=${VERSION}" -o /demo ./demo/${SERVICE}
FROM scratch
COPY --from=build /demo /demo
USER 65532:65532
ENTRYPOINT ["/demo"]
