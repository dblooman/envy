{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": [
    "installationID",
    "externalDatabase",
    "runtime"
  ],
  "properties": {
    "migrations": {
      "type": "object",
      "required": [
        "mode"
      ],
      "properties": {
        "mode": {
          "enum": [
            "hook",
            "init"
          ]
        }
      }
    },
    "installationID": {
      "type": "string",
      "minLength": 1
    },
    "externalDatabase": {
      "type": "object",
      "required": [
        "secretName",
        "secretKey"
      ],
      "properties": {
        "secretName": {
          "type": "string",
          "minLength": 1
        },
        "secretKey": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "auth": {
      "type": "object",
      "properties": {
        "mode": {
          "enum": [
            "token",
            "proxy",
            "none",
            "dev",
            "password",
            "google"
          ]
        }
      }
    },
    "mesh": {
      "type": "object",
      "properties": {
        "provider": {
          "enum": [
            "istio",
            "cilium",
            "linkerd"
          ]
        }
      }
    },
    "gatewayAPI": {
      "type": "object",
      "properties": {
        "gatewayClass": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "runtime": {
      "type": "object",
      "required": [
        "previewBaseURL",
        "ingressURL",
        "baselineHost"
      ],
      "properties": {
        "previewBaseURL": {
          "type": "string",
          "pattern": "^https?://"
        },
        "ingressURL": {
          "type": "string",
          "pattern": "^(https?://|$)"
        },
        "baselineHost": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "service": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "ClusterIP",
            "NodePort",
            "LoadBalancer"
          ]
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "nodePort": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 30000,
          "maximum": 32767
        }
      }
    },
    "preflight": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^/[^\\r\\n]*$"
        },
        "expectedStatus": {
          "type": "integer",
          "minimum": 200,
          "maximum": 299
        }
      }
    },
    "cilium": {
      "not": {}
    },
    "linkerd": {
      "not": {}
    },
    "pubsub": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      }
    },
    "namespacePolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "",
            "legacy",
            "isolated"
          ]
        },
        "ingress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "egress": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "pod_security": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "warn": {
              "enum": [
                "restricted",
                "baseline",
                "privileged"
              ]
            },
            "audit": {
              "enum": [
                "restricted",
                "baseline",
                "privileged"
              ]
            },
            "enforce": {
              "enum": [
                "restricted",
                "baseline",
                "privileged",
                ""
              ]
            },
            "version": {
              "type": "string",
              "pattern": "^v1\\.[0-9]+$"
            }
          }
        },
        "cilium_ingress": {
          "type": "boolean"
        }
      }
    }
  }
}
