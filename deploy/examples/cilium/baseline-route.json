{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "HTTPRoute",
  "metadata": {
    "name": "baseline-ingress",
    "namespace": "staging"
  },
  "spec": {
    "parentRefs": [
      {
        "name": "envy-preview",
        "sectionName": "https"
      }
    ],
    "hostnames": [
      "baseline.preview.example.com"
    ],
    "rules": [
      {
        "filters": [
          {
            "type": "RequestHeaderModifier",
            "requestHeaderModifier": {
              "remove": [
                "baggage"
              ]
            }
          }
        ],
        "backendRefs": [
          {
            "name": "api",
            "port": 8080
          }
        ]
      }
    ]
  }
}
