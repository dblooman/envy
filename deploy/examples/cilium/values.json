{
  "installationID": "acme-development",
  "mesh": {
    "provider": "cilium"
  },
  "externalDatabase": {
    "secretName": "envy-postgres",
    "secretKey": "url"
  },
  "auth": {
    "mode": "proxy",
    "externalOrigin": "https://envy.example.com",
    "proxySecret": {
      "name": "envy-proxy",
      "key": "secret"
    },
    "trustedProxyCIDRs": "10.0.0.0/8"
  },
  "runtime": {
    "previewBaseURL": "https://preview.example.com",
    "baselineHost": "baseline.preview.example.com",
    "ingressURL": "https://cilium-gateway-envy-preview.staging.svc.cluster.local",
    "caConfigMap": {
      "name": "",
      "key": "ca.crt"
    }
  },
  "networkPolicy": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "auth-proxy"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": "http"
          }
        ]
      }
    ]
  },
  "gatewayAPI": {
    "gatewayClass": "cilium"
  },
  "namespacePolicy": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "envy-system"
              }
            }
          },
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            }
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "k8s-app": "kube-dns"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          }
        ]
      }
    ],
    "pod_security": {
      "warn": "restricted",
      "audit": "restricted",
      "version": "v1.36"
    },
    "cilium_ingress": true
  }
}
