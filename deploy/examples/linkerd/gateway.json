{
  "apiVersion": "gateway.networking.k8s.io/v1",
  "kind": "Gateway",
  "metadata": {
    "name": "envy-preview",
    "namespace": "staging"
  },
  "spec": {
    "gatewayClassName": "eg",
    "listeners": [
      {
        "name": "https",
        "port": 443,
        "protocol": "HTTPS",
        "hostname": "*.preview.example.com",
        "tls": {
          "mode": "Terminate",
          "certificateRefs": [
            {
              "name": "preview-tls"
            }
          ]
        },
        "allowedRoutes": {
          "namespaces": {
            "from": "Same"
          }
        }
      }
    ]
  }
}
