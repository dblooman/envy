{
  "apiVersion": "networking.istio.io/v1",
  "kind": "Gateway",
  "metadata": {
    "name": "envy-preview",
    "namespace": "staging"
  },
  "spec": {
    "selector": {
      "istio": "ingressgateway"
    },
    "servers": [
      {
        "port": {
          "number": 443,
          "name": "https",
          "protocol": "HTTPS"
        },
        "hosts": [
          "*.preview.example.com"
        ],
        "tls": {
          "mode": "SIMPLE",
          "credentialName": "preview-tls"
        }
      }
    ]
  }
}
