{
  "installationID": "acme-development",
  "mesh": {
    "provider": "istio"
  },
  "externalDatabase": {
    "secretName": "envy-postgres",
    "secretKey": "url"
  },
  "auth": {
    "mode": "proxy",
    "externalOrigin": "https://envy.example.com",
    "proxySecret": {
      "name": "envy-proxy",
      "key": "secret"
    },
    "trustedProxyCIDRs": "10.0.0.0/8"
  },
  "runtime": {
    "previewBaseURL": "https://preview.example.com",
    "baselineHost": "baseline.preview.example.com",
    "ingressURL": "https://istio-ingressgateway.istio-system.svc.cluster.local",
    "caConfigMap": {
      "name": "",
      "key": "ca.crt"
    }
  },
  "networkPolicy": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "auth-proxy"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": "http"
          }
        ]
      }
    ]
  },
  "istio": {
    "injectionLabels": {
      "istio.io/rev": "default"
    },
    "ingressSelector": {
      "istio": "ingressgateway"
    }
  },
  "namespacePolicy": {
    "ingress": [
      {
        "from": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "envy-system"
              }
            }
          },
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "istio-system"
              }
            }
          }
        ]
      }
    ],
    "egress": [
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "kube-system"
              }
            },
            "podSelector": {
              "matchLabels": {
                "k8s-app": "kube-dns"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "UDP",
            "port": 53
          },
          {
            "protocol": "TCP",
            "port": 53
          }
        ]
      },
      {
        "to": [
          {
            "namespaceSelector": {
              "matchLabels": {
                "kubernetes.io/metadata.name": "istio-system"
              }
            }
          }
        ],
        "ports": [
          {
            "protocol": "TCP",
            "port": 15012
          }
        ]
      }
    ],
    "pod_security": {
      "warn": "restricted",
      "audit": "restricted",
      "version": "v1.36"
    }
  }
}
