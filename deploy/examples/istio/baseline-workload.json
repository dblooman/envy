{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "v1",
      "kind": "Namespace",
      "metadata": {
        "name": "staging",
        "labels": {
          "istio.io/rev": "default"
        }
      }
    },
    {
      "apiVersion": "v1",
      "kind": "Service",
      "metadata": {
        "name": "api",
        "namespace": "staging"
      },
      "spec": {
        "selector": {
          "app": "api"
        },
        "ports": [
          {
            "name": "http",
            "port": 8080,
            "targetPort": "http"
          }
        ]
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "staging"
      },
      "spec": {
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app": "api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app": "api"
            }
          },
          "spec": {
            "containers": [
              {
                "name": "api",
                "image": "registry.example.com/api:baseline",
                "ports": [
                  {
                    "name": "http",
                    "containerPort": 8080
                  }
                ],
                "readinessProbe": {
                  "httpGet": {
                    "path": "/readyz",
                    "port": "http"
                  }
                },
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "500m",
                    "memory": "256Mi"
                  }
                }
              }
            ]
          }
        }
      }
    }
  ]
}
