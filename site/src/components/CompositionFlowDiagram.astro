---
import ServiceDiagram from './ServiceDiagram.astro';
---
<section id="architecture" class="composition-visual" aria-labelledby="composition-visual-title">
  <header>
    <span class="envy-badge envy-badge-emerald">Composition model</span>
    <h2 id="composition-visual-title">Follow a request through your preview</h2>
    <p>The services stay connected. Only the workloads you select are replaced.</p>
  </header>
  <ServiceDiagram name="composition" id="home-composition" wide />
  <p class="diagram-note">Applications forward W3C Baggage between HTTP calls. Your mesh uses that context to choose a destination. <a href="/reference/routing/">Explore the routing contract →</a></p>
</section>
<style>
  .composition-visual { margin: 3rem 0; }
  header { max-width: 720px; }
  h2 { font-size: clamp(1.65rem, 3vw, 2.3rem); color: var(--sl-color-white); line-height: 1.2; margin: 0.9rem 0; letter-spacing: -0.03em; }
  header p, .diagram-note { color: var(--sl-color-gray-2); font-size: 0.95rem; line-height: 1.6; }
  .diagram-note { max-width: 800px; }
</style>
