---
import { withBase } from "../lib/paths.mjs";
import ServiceDiagram from "./ServiceDiagram.astro";
---

<section class="agent-skills-banner">
  <div class="agent-banner-inner">
    <div class="agent-text-col">
      <div class="agent-badge-row">
        <span class="envy-badge envy-badge-blue">Model Context Protocol</span>
        <span class="envy-badge">Build and test</span>
      </div>
      <h2 class="agent-title">Give coding agents a preview to test</h2>
      <p class="agent-p">
        With Envy's MCP interfaces, coding agents can create Kubernetes preview
        environments, wait for mesh ingress verification, run curl or Playwright
        tests against real services, inspect bounded container logs, and tear
        down when done.
      </p>

      <div class="agent-tools-pills">
        <span class="tool-pill">create_composition</span>
        <span class="tool-pill">wait_for_composition</span>
        <span class="tool-pill">get_component_logs</span>
        <span class="tool-pill">update_composition</span>
        <span class="tool-pill">destroy_composition</span>
      </div>

      <div class="agent-cta-row">
        <a href={withBase("/agents/mcp-server/")} class="agent-btn primary">
          Configure the MCP server →
        </a>
        <a href={withBase("/agents/workflow/")} class="agent-btn secondary">
          Read AGENTS.md Workflow Kit
        </a>
      </div>
    </div>

    <div class="agent-flow-col">
      <ServiceDiagram name="agent-summary" id="home-agent-workflow" />
    </div>
  </div>
</section>

<style>
  .agent-skills-banner {
    margin: 3.5rem 0;
    border: 1px solid #bfdbfe;
    background: linear-gradient(135deg, #eff6ff 0%, #f0fdf4 100%);
    border-radius: 14px;
    padding: 2.5rem;
    box-shadow: 0 4px 20px rgba(37, 99, 235, 0.05);
  }

  :root[data-theme="dark"] .agent-skills-banner {
    border-color: #1e3a8a;
    background: linear-gradient(135deg, #0f172a 0%, #064e3b 100%);
  }

  .agent-banner-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .agent-badge-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }

  .agent-title {
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin: 0 0 0.85rem;
    line-height: 1.25;
  }

  .agent-p {
    font-size: 0.975rem;
    line-height: 1.6;
    color: var(--sl-color-gray-2);
    margin: 0 0 1.25rem;
  }

  .agent-tools-pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.5rem;
  }

  .tool-pill {
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
    background: var(--sl-color-black);
    color: #2563eb;
    border: 1px solid #93c5fd;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    font-weight: 600;
  }

  :root[data-theme="dark"] .tool-pill {
    color: #93c5fd;
    border-color: #1d4ed8;
  }

  .agent-cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .agent-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.55rem 1.15rem;
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none !important;
    transition: all 0.15s ease;
  }

  .agent-btn.primary {
    background: #1e40af;
    color: #ffffff !important;
  }

  .agent-btn.primary:hover {
    background: #1d4ed8;
  }

  :root[data-theme="dark"] .agent-btn.primary {
    background: #3b82f6;
    color: #020617 !important;
  }

  .agent-btn.secondary {
    background: var(--sl-color-black);
    color: var(--sl-color-gray-1) !important;
    border: 1px solid var(--sl-color-gray-5);
  }

  .agent-btn.secondary:hover {
    background: var(--sl-color-gray-6);
  }

  .agent-text-col,
  .agent-flow-col,
  .step-body {
    min-width: 0;
    overflow-wrap: anywhere;
  }

  @media (max-width: 600px) {
    .agent-skills-banner {
      padding: 1.25rem;
    }
  }

  @media (max-width: 860px) {
    .agent-banner-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
