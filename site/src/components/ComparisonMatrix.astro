---
// site/src/components/ComparisonMatrix.astro
---

<section class="comparison-section">
  <div class="comparison-header">
    <span class="envy-badge envy-badge-emerald">Deployment tradeoffs</span>
    <h2 class="section-title">Namespace Duplication vs. Envy</h2>
    <p class="section-subtitle">
      Choose based on how much of the application and its data each preview
      needs to isolate.
    </p>
  </div>

  <p class="table-hint">
    On small screens, scroll the table sideways to compare both approaches.
  </p>
  <div
    class="table-container"
    role="region"
    aria-label="Preview deployment comparison"
    tabindex="0"
  >
    <table class="comparison-table">
      <caption class="sr-only"
        >Full namespace cloning compared with Envy selective overrides</caption
      >
      <thead>
        <tr>
          <th scope="col" class="feature-col">Dimension</th>
          <th scope="col" class="traditional-col">Namespace / Helm Cloning</th>
          <th scope="col" class="envy-col">
            <div class="envy-th-badge">
              <span>Envy Selective Overrides</span>
            </div>
          </th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td class="feature-name">
            <strong>Resource Overhead</strong>
            <span class="feature-sub">Pods & memory per preview</span>
          </td>
          <td class="traditional-val">
            <span class="badge-bad">Full Duplication</span>
            <p>
              A full clone deploys a separate copy of the application and any
              included stateful dependencies.
            </p>
          </td>
          <td class="envy-val">
            <span class="badge-good">Selective Overrides</span>
            <p>
              <strong>0 to 3 services</strong> overridden. Unchanged microservices,
              caches, and storage are shared from baseline.
            </p>
          </td>
        </tr>

        <tr>
          <td class="feature-name">
            <strong>Creation Time</strong>
            <span class="feature-sub">From command to live preview URL</span>
          </td>
          <td class="traditional-val">
            <span class="badge-bad">Whole application startup</span>
            <p>
              Readiness depends on all cloned workloads, volumes, and any
              database initialization.
            </p>
          </td>
          <td class="envy-val">
            <span class="badge-good">Changed service startup</span>
            <p>
              The URL is allocated at creation. Use it after workloads, routes,
              and ingress verification are ready.
            </p>
          </td>
        </tr>

        <tr>
          <td class="feature-name">
            <strong>Data isolation</strong>
            <span class="feature-sub">Where preview writes go</span>
          </td>
          <td class="traditional-val">
            <span class="badge-bad">Separate state</span>
            <p>
              A separate database can isolate test writes, but needs
              provisioning and suitable test data.
            </p>
          </td>
          <td class="envy-val">
            <span class="badge-good">Live Baseline State</span>
            <p>
              Preview writes affect shared baseline data. Use separate test
              tenants or dedicated data services when isolation is required.
            </p>
          </td>
        </tr>

        <tr>
          <td class="feature-name">
            <strong>AI Agent Tooling</strong>
            <span class="feature-sub">Automation interface</span>
          </td>
          <td class="traditional-val">
            <span class="badge-bad">Depends on tooling</span>
            <p>
              Typically managed through deployment scripts, CI workflows, or
              platform APIs.
            </p>
          </td>
          <td class="envy-val">
            <span class="badge-good">HTTP & Stdio MCP</span>
            <p>
              MCP tools create previews, wait for readiness, fetch logs, and
              request teardown. Agents run their own tests.
            </p>
          </td>
        </tr>

        <tr>
          <td class="feature-name">
            <strong>Teardown & Expiry</strong>
            <span class="feature-sub">Resource reclamation</span>
          </td>
          <td class="traditional-val">
            <span class="badge-bad">Lifecycle automation</span>
            <p>
              Cleanup depends on the CI or platform lifecycle policy configured
              for each preview.
            </p>
          </td>
          <td class="envy-val">
            <span class="badge-good">TTL-based cleanup</span>
            <p>
              Configurable TTL (8h default) and persisted deletion intent. The
              reconciler retries cleanup when dependencies recover.
            </p>
          </td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  .table-hint {
    display: none;
  }
  @media (max-width: 720px) {
    .table-hint {
      display: block;
      font-size: 0.875rem;
    }
  }

  .comparison-section {
    padding: 3rem 0;
  }

  .comparison-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 2.5rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin: 0.75rem 0 0.5rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--sl-color-gray-3);
    line-height: 1.6;
    margin: 0;
  }

  .table-container {
    overflow-x: auto;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 12px;
    background: var(--sl-color-black);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.03);
  }

  .comparison-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    min-width: 650px;
  }

  .comparison-table th {
    padding: 1.25rem 1.5rem;
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--sl-color-gray-6);
  }

  .feature-col {
    width: 25%;
    color: var(--sl-color-gray-3);
  }

  .traditional-col {
    width: 37.5%;
    color: var(--sl-color-gray-2);
  }

  .envy-col {
    width: 37.5%;
    background: #ecfdf5 !important;
  }

  :root[data-theme="dark"] .envy-col {
    background: #064e3b !important;
  }

  .envy-th-badge {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    color: #047857;
    font-weight: 800;
  }

  :root[data-theme="dark"] .envy-th-badge {
    color: #6ee7b7;
  }

  .pill-rec {
    font-size: 0.65rem;
    background: #10b981;
    color: #ffffff;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    font-weight: 700;
  }

  .comparison-table td {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    vertical-align: top;
  }

  .comparison-table tr:last-child td {
    border-bottom: none;
  }

  .feature-name {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .feature-name strong {
    font-size: 0.95rem;
    color: var(--sl-color-white);
  }

  .feature-sub {
    font-size: 0.75rem;
    color: var(--sl-color-gray-3);
  }

  .traditional-val p,
  .envy-val p {
    font-size: 0.85rem;
    line-height: 1.5;
    margin: 0.4rem 0 0;
    color: var(--sl-color-gray-2);
  }

  .envy-val {
    background: rgba(236, 253, 245, 0.4);
  }

  :root[data-theme="dark"] .envy-val {
    background: rgba(6, 78, 59, 0.15);
  }

  .badge-bad {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.725rem;
    font-weight: 700;
    background: #fee2e2;
    color: #b91c1c;
    font-family: var(--sl-font-mono);
  }

  :root[data-theme="dark"] .badge-bad {
    background: #7f1d1d;
    color: #fca5a5;
  }

  .badge-good {
    display: inline-block;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    font-size: 0.725rem;
    font-weight: 700;
    background: #d1fae5;
    color: #047857;
    font-family: var(--sl-font-mono);
  }

  :root[data-theme="dark"] .badge-good {
    background: #064e3b;
    color: #6ee7b7;
  }
</style>
