---
// site/src/components/CapabilitiesGrid.astro
---

<section class="capabilities-section">
  <div class="capabilities-header">
    <span class="envy-badge envy-badge-emerald">Capabilities</span>
    <h2 class="section-title">Deploy the changes. Reuse the rest.</h2>
    <p class="section-subtitle">
      Create previews with one to three service overrides, inspect their
      readiness, and remove them when testing is complete.
    </p>
  </div>

  <div class="capabilities-grid">
    <!-- Card 1 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-emerald">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            d="M16 16v1a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2h11a2 2 0 0 1 2 2v1"
          ></path><path d="M18 8h4a1 1 0 0 1 1 1v7a1 1 0 0 1-1 1h-4"
          ></path><circle cx="8" cy="12" r="2"></circle></svg
        >
      </div>
      <div class="card-badge">Zero-Copy Architecture</div>
      <h3 class="card-title">Shared Reference Baseline</h3>
      <p class="card-desc">
        Compositions reuse unchanged services from an approved running
        application. Only the one to three services selected for an override
        receive new workloads.
      </p>
      <div class="card-footer">
        <span class="footer-tag">Fewer duplicated workloads</span>
      </div>
    </div>

    <!-- Card 2 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-blue">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path d="m15 15 6 6m-6-6v4.8m0-4.8h4.8"></path><path
            d="M9 19.8V15m0 0H4.2m4.8 0-6 6"></path><path
            d="M15 4.2V9m0 0h4.8m-4.8 0 6-6"></path><path
            d="M9 4.2V9m0 0H4.2m4.8 0-6-6"></path></svg
        >
      </div>
      <div class="card-badge">W3C Baggage</div>
      <h3 class="card-title">Use your existing mesh</h3>
      <p class="card-desc">
        Preview ingress hostnames automatically set <code
          >baggage: composition=&lt;id&gt;</code
        >. Applications forward that header on downstream calls, and your Istio
        or Cilium mesh selects the matching override. Envy does not proxy
        application traffic.
      </p>
      <div class="card-footer">
        <span class="footer-tag">Routing stays in the service mesh</span>
      </div>
    </div>

    <!-- Card 3 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-purple">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><rect width="18" height="18" x="3" y="3" rx="2"></rect><path
            d="M8 12h8"></path><path d="M12 8v8"></path></svg
        >
      </div>
      <div class="card-badge">Model Context Protocol</div>
      <h3 class="card-title">Tools for coding agents</h3>
      <p class="card-desc">
        A built-in stdio MCP server exposes <code>create_composition</code>, <code
          >wait_for_composition</code
        >, <code>get_component_logs</code>, and <code>destroy_composition</code> directly
        to Claude, Cursor, and Antigravity.
      </p>
      <div class="card-footer">
        <span class="footer-tag">Create, wait, inspect, and destroy</span>
      </div>
    </div>

    <!-- Card 4 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-amber">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><ellipse cx="12" cy="5" rx="9" ry="3"></ellipse><path
            d="M3 5V19A9 3 0 0 0 21 19V5"></path><path d="M3 12A9 3 0 0 0 21 12"
          ></path></svg
        >
      </div>
      <div class="card-badge">Durable Persistence</div>
      <h3 class="card-title">Out-of-Band PostgreSQL State</h3>
      <p class="card-desc">
        Desired state, lifecycle history, and idempotency records are stored in
        PostgreSQL with advisory locks and optimistic concurrency. Reconciler
        crashes or restarts never take down running previews.
      </p>
      <div class="card-footer">
        <span class="footer-tag">Durable lifecycle state</span>
      </div>
    </div>

    <!-- Card 5 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-cyan">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><polyline points="4 17 10 11 4 5"></polyline><line
            x1="12"
            x2="20"
            y1="19"
            y2="19"></line></svg
        >
      </div>
      <div class="card-badge">Developer Ergonomics</div>
      <h3 class="card-title">Delivery CLI & REST API</h3>
      <p class="card-desc">
        A single binary CLI with structured JSON output, generation tracking,
        and rolling image updates. Easily integrated into GitHub Actions,
        Makefiles, GitLab CI, or custom shell automation.
      </p>
      <div class="card-footer">
        <span class="footer-tag">Updates check the current generation</span>
      </div>
    </div>

    <!-- Card 6 -->
    <div class="envy-card">
      <div class="card-icon-wrapper icon-rose">
        <svg
          aria-hidden="true"
          xmlns="http://www.w3.org/2000/svg"
          width="22"
          height="22"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          ><path
            d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"
          ></path><polyline points="3.29 7 12 12 20.71 7"></polyline><line
            x1="12"
            x2="12"
            y1="22"
            y2="12"></line></svg
        >
      </div>
      <div class="card-badge">Full-Stack Previews</div>
      <h3 class="card-title">Connect frontend previews</h3>
      <p class="card-desc">
        Connect frontend PRs (Cloudflare Pages / Vercel) directly to backend
        microservice compositions. Bind exact Git commit SHAs, run browser
        verification, and record test results.
      </p>
      <div class="card-footer">
        <span class="footer-tag">End-to-End Request Verification</span>
      </div>
    </div>
  </div>
</section>

<style>
  .capabilities-section {
    padding: 3rem 0;
  }

  .capabilities-header {
    text-align: center;
    max-width: 650px;
    margin: 0 auto 3rem;
  }

  .section-title {
    font-size: clamp(1.8rem, 3.5vw, 2.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
    margin: 0.75rem 0 0.5rem;
  }

  .section-subtitle {
    font-size: 1.05rem;
    color: var(--sl-color-gray-3);
    line-height: 1.6;
    margin: 0;
  }

  .capabilities-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 320px), 1fr));
    gap: 1.5rem;
  }

  .envy-card {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .card-icon-wrapper {
    width: 44px;
    height: 44px;
    border-radius: 10px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 1rem;
  }

  .icon-emerald {
    background: #ecfdf5;
    color: #059669;
  }
  .icon-blue {
    background: #eff6ff;
    color: #2563eb;
  }
  .icon-purple {
    background: #faf5ff;
    color: #9333ea;
  }
  .icon-amber {
    background: #fffbeb;
    color: #d97706;
  }
  .icon-cyan {
    background: #ecfeff;
    color: #0891b2;
  }
  .icon-rose {
    background: #fff1f2;
    color: #e11d48;
  }

  :root[data-theme="dark"] .icon-emerald {
    background: #064e3b;
    color: #34d399;
  }
  :root[data-theme="dark"] .icon-blue {
    background: #1e3a8a;
    color: #60a5fa;
  }
  :root[data-theme="dark"] .icon-purple {
    background: #581c87;
    color: #c084fc;
  }
  :root[data-theme="dark"] .icon-amber {
    background: #78350f;
    color: #fcd34d;
  }
  :root[data-theme="dark"] .icon-cyan {
    background: #164e63;
    color: #67e8f9;
  }
  :root[data-theme="dark"] .icon-rose {
    background: #881337;
    color: #fda4af;
  }

  .card-badge {
    font-size: 0.725rem;
    font-family: var(--sl-font-mono);
    text-transform: uppercase;
    font-weight: 700;
    color: var(--sl-color-gray-3);
    letter-spacing: 0.04em;
    margin-bottom: 0.35rem;
  }

  .card-title {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--sl-color-white);
    margin: 0 0 0.5rem;
    letter-spacing: -0.015em;
  }

  .card-desc {
    font-size: 0.9rem;
    color: var(--sl-color-gray-3);
    line-height: 1.55;
    margin: 0 0 1.25rem;
  }

  .card-desc code {
    font-family: var(--sl-font-mono);
    font-size: 0.8rem;
    background: var(--sl-color-gray-6);
    border: 1px solid var(--sl-color-gray-5);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
    color: var(--sl-color-gray-1);
  }

  .card-footer {
    border-top: 1px solid var(--sl-color-gray-5);
    padding-top: 0.85rem;
    margin-top: auto;
  }

  .footer-tag {
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--sl-color-accent);
    font-family: var(--sl-font-mono);
  }

  @media (max-width: 720px) {
    .capabilities-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
