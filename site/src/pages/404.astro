---
import { siteOrigin, withBase } from "../lib/paths.mjs";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const frontmatter = {
  title: "Page not found",
  description: "The requested Envy documentation page could not be found.",
  template: "splash",
  head: [
    {
      tag: "link" as const,
      attrs: { rel: "canonical", href: siteOrigin + withBase("/404.html") },
    },
    {
      tag: "meta" as const,
      attrs: {
        property: "og:url",
        content: siteOrigin + withBase("/404.html"),
      },
    },
    { tag: "meta" as const, attrs: { name: "robots", content: "noindex" } },
  ],
};
---

<StarlightPage frontmatter={frontmatter}>
  <p>The documentation page you requested does not exist or has moved.</p>
  <p>
    <a href={withBase("/")}>Return to the documentation home</a> or
    <a href={withBase("/getting-started/installation/")}
      >start with installing a release</a
    >.
  </p>
</StarlightPage>
